# lzplay revival workspace - .gitignore
# Large binaries, emulator images and AV-flagged blobs stay local.

# --- emulator images (6 GB) ---
work/avd/
work/android_home/
work/tmp/

# --- third-party tool blobs ---
work/tools/*.jar
work/tools/*.zip
work/tools/*.whl
work/tools/jadx_lib/
work/tools/jadx_pom/
work/tools/wheels/
work/apktool_frame/

# --- 360 Jiagu native libs: antivirus (Huorong) quarantines these on sight ---
work/native/*.so
work/native/an/
work/carve/

# --- large generated / regenerable artifacts ---
work/probe_out/
work/inside/
work/inner_decoded/
work/apktool_out/
work/*/build/
work/__pycache__/
work/pylibs/

# --- decompiled trees are regenerable from the APKs ---
work/travel_decoded/
work/chat_decoded/
work/chat_smali/
work/chat_smali_only/
work/chat_dex/

# --- patch backups (small, regenerable) ---
work/travel_backup/
work/chat_backup_smali/
work/chat_backup/

# --- intermediate APK builds (140 MB each; final deliverables live in root) ---
work/travel_p*.apk
work/travel_rebuilt*.apk
work/chat_rebuilt*.apk
work/chat_patched.apk
*.idsig

# --- third-party APKs under analysis (140 MB+). Keep only our own tools. ---
*.apk
!LZProbe.apk
!LZRevive.apk
!com.lzplay.helper.apk
!work/insidehelper.apk

# --- scratch (screenshots / uiautomator dumps produced while probing) ---
work/*.png
work/*.xml
work/scratch/
*.log
*.tmp
# --- subagent research scratch (jars, decompiled trees, downloaded tools) ---
work/research-*/
